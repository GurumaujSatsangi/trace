<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TRACE - AI Compliance</title>
    <style>
        :root {
            --bg: #ffffff;
            --sidebar-bg: #111827;
            --sidebar-text: #f3f4f6;
            --primary: #10b981;
            --primary-hover: #059669;
            --border: #e5e7eb;
            --user-msg: #f3f4f6;
            --ai-msg: #ffffff;
            --text-main: #1f2937;
        }

        body, html {
            margin: 0; padding: 0; height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background: var(--bg); color: var(--text-main);
            overflow: hidden;
        }

        .app-container {
            display: flex; height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 320px; background: var(--sidebar-bg); color: var(--sidebar-text);
            display: flex; flex-direction: column; padding: 24px; box-sizing: border-box;
            border-right: 1px solid #1f2937;
        }

        .sidebar-header h2 { margin: 0 0 4px 0; font-size: 24px; color: white; letter-spacing: 1px; }
        .sidebar-header p { margin: 0 0 30px 0; font-size: 13px; color: #9ca3af; }

        .sidebar-section h3 { font-size: 12px; text-transform: uppercase; color: #6b7280; letter-spacing: 1px; margin-bottom: 12px; }
        
        input[type="file"] { width: 100%; padding: 10px; margin-bottom: 15px; background: #1f2937; border: 1px dashed #374151; border-radius: 8px; color: #d1d5db; box-sizing: border-box; }
        .btn-sidebar { width: 100%; background: var(--primary); color: white; border: none; padding: 12px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 14px; transition: 0.2s; }
        .btn-sidebar:hover { background: var(--primary-hover); }
        .btn-sidebar:disabled { background: #374151; color: #9ca3af; cursor: not-allowed; }

        #uploadStatus { margin-top: 15px; font-size: 13px; line-height: 1.5; padding: 10px; border-radius: 6px; }
        #uploadStatus.success { background: #064e3b; color: #a7f3d0; }
        #uploadStatus.error { background: #7f1d1d; color: #fecaca; }
        #uploadStatus.processing { background: #1e3a8a; color: #bfdbfe; }

        /* Main Chat Area */
        .chat-container {
            flex: 1; display: flex; flex-direction: column; background: #ffffff;
            position: relative;
        }

        .chat-history {
            flex: 1; overflow-y: auto; padding: 40px 20px; display: flex; flex-direction: column; gap: 30px;
            scroll-behavior: smooth;
        }

        .message {
            display: flex; gap: 16px; max-width: 850px; margin: 0 auto; width: 100%;
        }

        .message.user { flex-direction: row-reverse; }
        
        .avatar {
            width: 34px; height: 34px; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 12px; flex-shrink: 0; color: white;
        }
        .message.ai .avatar { background: #10b981; }
        .message.user .avatar { background: #3b82f6; display: none; }

        .message-content {
            font-size: 15px; line-height: 1.6; max-width: 85%;
        }

        .message.user .message-content {
            background: #f3f4f6; color: #111827; padding: 12px 18px; border-radius: 20px; border-bottom-right-radius: 4px;
        }

        /* AI Message Rich Content Elements */
        .verdict-box { background: #ffffff; border: 1px solid #e5e7eb; padding: 16px; border-radius: 8px; margin-bottom: 16px; color: #1f2937; font-size: 14.5px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; background: white; }
        th, td { border: 1px solid #e5e7eb; padding: 10px 14px; text-align: left; }
        th { background: #f8fafc; font-weight: 600; color: #475569; }
        .table-responsive { overflow-x: auto; border-radius: 8px; border: 1px solid #e5e7eb; margin-bottom: 16px; }
        .sql-pre { background: #0f172a; color: #e2e8f0; padding: 12px 16px; border-radius: 8px; font-size: 13px; overflow-x: auto; margin: 0; }
        .sql-header { font-size: 12px; color: #64748b; margin-bottom: 6px; font-weight: 600; text-transform: uppercase; }

        /* Input Area */
        .input-area {
            padding: 20px 40px 30px 40px; background: linear-gradient(0deg, white 60%, rgba(255,255,255,0));
        }

        .input-area form {
            max-width: 850px; margin: 0 auto; position: relative; display: flex; gap: 12px; align-items: flex-end;
            background: white; border: 1px solid #d1d5db; border-radius: 24px; padding: 8px 12px; box-shadow: 0 0 15px rgba(0,0,0,0.05);
        }
        .input-area form:focus-within { border-color: #3b82f6; box-shadow: 0 0 20px rgba(59,130,246,0.1); }

        .input-area textarea {
            flex: 1; min-height: 24px; max-height: 200px; padding: 10px 8px; border: none; resize: none; font-size: 15px; line-height: 1.5; font-family: inherit; background: transparent; outline: none;
        }

        .input-area button {
            height: 40px; width: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #10b981; color: white; border: none; cursor: pointer; transition: 0.2s; flex-shrink: 0;
        }
        .input-area button:hover { background: #059669; }
        .input-area button:disabled { background: #d1d5db; cursor: not-allowed; }

        /* Loading Spinner */
        .loading-badge { display: inline-flex; align-items: center; gap: 10px; background: #eff6ff; padding: 8px 16px; border-radius: 20px; font-size: 13px; color: #1e40af; border: 1px solid #bfdbfe; margin-bottom: 20px; font-weight: 500; }
        .spinner-small { width: 14px; height: 14px; border: 2px solid #93c5fd; border-top-color: #2563eb; border-radius: 50%; animation: spin 0.8s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* Tabular View & Modals */
        #tabularView { flex: 1; padding: 40px; overflow-y: auto; display: none; background: #f9fafb; }
        #tabularView h2 { margin-top: 0; margin-bottom: 24px; color: #111827; }
        .reports-table { width: 100%; border-collapse: collapse; background: white; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden; font-size: 14px; }
        .reports-table th, .reports-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid #e5e7eb; }
        .reports-table th { background: #f3f4f6; font-weight: 600; color: #374151; }
        .reports-table tr:last-child td { border-bottom: none; }
        .reports-table tr:hover { background: #f8fafc; }
        .reports-table a { color: #2563eb; text-decoration: none; cursor: pointer; font-weight: 500; }
        .reports-table a:hover { text-decoration: underline; }
        .btn-view-details { background: #e0e7ff; color: #4338ca; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-size: 13px; font-weight: 500; transition: 0.2s; }
        .btn-view-details:hover { background: #c7d2fe; }

        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal-content { background: white; width: 85%; max-width: 900px; max-height: 85vh; border-radius: 8px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04); }
        .modal-header { padding: 16px 20px; border-bottom: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; background: #f8fafc; }
        .modal-header h3 { margin: 0; color: #0f172a; font-size: 18px; }
        .close-modal { background: none; border: none; font-size: 24px; cursor: pointer; color: #64748b; line-height: 1; padding: 0; }
        .close-modal:hover { color: #0f172a; }
        .modal-body { padding: 20px; overflow-y: auto; flex: 1; }
        .json-pre { background: #0f172a; color: #e2e8f0; padding: 16px; border-radius: 8px; overflow-x: auto; margin: 0; font-size: 13.5px; line-height: 1.5; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2>TRACE</h2>
                <p>AI Compliance Engine</p>
            </div>
            
            <div class="sidebar-section">
                <h3>1. Dataset Upload</h3>
                <form id="uploadForm">
                    <input type="file" name="csvFile" id="csvFile" accept=".csv" required>
                    <button type="submit" id="uploadBtn" class="btn-sidebar">Upload & Sync</button>
                </form>
                <div id="uploadStatus" style="display: none;"></div>
            </div>

            <div class="sidebar-section" style="margin-top: 24px;">
                <h3>2. Views</h3>
                <button type="button" id="chatViewBtn" class="btn-sidebar" style="margin-bottom: 12px;">Chat View</button>
                <button type="button" id="tabViewBtn" class="btn-sidebar" style="background: #374151;">Tabular View</button>
            </div>
        </aside>

        <!-- Main Chat Area -->
        <main class="chat-container" id="chatView">
            <div class="chat-history" id="chatHistory">
                <!-- Welcome Message -->
                <div class="message ai">
                    <div class="avatar">AI</div>
                    <div class="message-content">
                        <strong>Hello! I am TRACE, your AI Compliance Officer.</strong><br><br>
                        Please upload your transaction dataset in the sidebar first. Once synced, you can ask me to analyze accounts, find high-risk transactions, or evaluate compliance rules!
                    </div>
                </div>
            </div>

            <!-- Input area -->
            <div class="input-area">
                <form id="chatForm">
                    <textarea name="message" id="messageInput" placeholder="Message TRACE (e.g., Show me transactions by ACC1009...)" required rows="1" oninput="this.style.height = ''; this.style.height = this.scrollHeight + 'px'"></textarea>
                    <button type="submit" id="chatBtn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                    </button>
                </form>
            </div>
        </main>

        <!-- Tabular View Area -->
        <main id="tabularView">
            <h2>Compliance Reports</h2>
            <div style="overflow-x: auto; border-radius: 8px; border: 1px solid #e5e7eb;">
                <table class="reports-table">
                    <thead>
                        <tr>
                            <th>Account ID</th>
                            <th>Transaction ID</th>
                            <th>Risk Score</th>
                            <th>Risk Level</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="reportsTableBody">
                        <tr><td colspan="5" style="text-align: center; color: #64748b;">No data loaded.</td></tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <!-- Modals -->
    <div id="reportModal" class="modal-overlay" onclick="if(event.target===this) closeModal('reportModal')">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="reportModalTitle">Compliance Report Details</h3>
                <button class="close-modal" onclick="closeModal('reportModal')">&times;</button>
            </div>
            <div class="modal-body">
                <div id="reportModalContent"></div>
            </div>
        </div>
    </div>

    <div id="transactionModal" class="modal-overlay" onclick="if(event.target===this) closeModal('transactionModal')">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="transactionModalTitle">Transaction Details</h3>
                <button class="close-modal" onclick="closeModal('transactionModal')">&times;</button>
            </div>
            <div class="modal-body">
                <div id="transactionModalContent"></div>
            </div>
        </div>
    </div>

    <script>
        const chatHistory = document.getElementById('chatHistory');
        const uploadForm = document.getElementById('uploadForm');
        const chatForm = document.getElementById('chatForm');
        
        function scrollToBottom() {
            chatHistory.scrollTop = chatHistory.scrollHeight;
        }

        function appendUserMessage(text) {
            const msg = document.createElement('div');
            msg.className = 'message user';
            msg.innerHTML = `
                <div class="avatar">U</div>
                <div class="message-content">${text.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</div>
            `;
            chatHistory.appendChild(msg);
            scrollToBottom();
        }

        function appendAiMessage(htmlContent) {
            const msg = document.createElement('div');
            msg.className = 'message ai';
            msg.innerHTML = `
                <div class="avatar">AI</div>
                <div class="message-content" style="width: 100%; max-width: 100%;">${htmlContent}</div>
            `;
            chatHistory.appendChild(msg);
            scrollToBottom();
            return msg;
        }

        // Handle CSV Upload
        uploadForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData();
            const fileField = document.getElementById('csvFile');
            const statusEl = document.getElementById('uploadStatus');
            const submitBtn = document.getElementById('uploadBtn');

            if (fileField.files.length === 0) return;
            formData.append('csvFile', fileField.files[0]);

            statusEl.style.display = 'block';
            statusEl.textContent = "Processing and analyzing dataset...";
            statusEl.className = "processing";
            submitBtn.disabled = true;

            try {
                const response = await fetch('/api/upload', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                
                if (response.ok) {
                    statusEl.textContent = `✓ ${result.message}`;
                    statusEl.className = "success";
                    appendAiMessage(`<strong>Dataset Uploaded Successfully</strong><br>Parsed and synced ${result.totalInserted} records. I am ready to answer your questions!`);
                } else {
                    statusEl.textContent = `✗ Error: ${result.error || 'Upload failed'}`;
                    statusEl.className = "error";
                }
            } catch (err) {
                statusEl.textContent = `✗ Network error during upload.`;
                statusEl.className = "error";
            } finally {
                submitBtn.disabled = false;
            }
        });

        // Handle Chat Query
        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            const submitBtn = document.getElementById('chatBtn');

            if (!message) return;

            // Add user message to UI
            appendUserMessage(message);
            messageInput.value = '';
            messageInput.style.height = '';
            submitBtn.disabled = true;

            // Show Loading Indicator in Chat
            const loader = appendAiMessage(`
                <div class="loading-badge" id="activeLoader">
                    <div class="spinner-small"></div>
                    Evaluating AML patterns...
                </div>
            `);

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message })
                });
                const result = await response.json();

                // Remove loader
                loader.remove();

                if (result.success && result.results) {
                    let aiHtml = '';

                    // Verdict
                    if (result.complianceVerdict) {
                        aiHtml += `<div class="verdict-box">${result.complianceVerdict.replace(/\n/g, '<br>')}</div>`;
                    }

                    const highRiskTxns = result.results.filter(r => r.risk_level && r.risk_level.toUpperCase() === 'HIGH');
                    if (highRiskTxns.length > 0) {
                        // Use the first high risk transaction for the SAR report by default
                        const txnData = encodeURIComponent(JSON.stringify(highRiskTxns[0]));
                        const verdictData = encodeURIComponent(result.complianceVerdict || "");
                        aiHtml += `<button style="margin-top: 10px; background-color: #dc2626; color: white; font-weight: bold; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="downloadSAR('${txnData}', '${verdictData}')">
                                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                      Download SAR
                                   </button>`;
                    }

                    appendAiMessage(aiHtml);
                } else if (result.error === "RATE_LIMIT" || response.status === 429) {
                    const waitTime = result.retryAfter || 15;
                    const msgId = 'countdown-' + Date.now();
                    appendAiMessage(`<div style="color: #ea580c; font-weight: 500; font-size: 14.5px;">Rate limit reached. Please wait <span id="${msgId}">${waitTime}</span> seconds before sending another message.</div>`);
                    
                    submitBtn.setAttribute('data-rate-limited', 'true');
                    submitBtn.disabled = true;
                    messageInput.disabled = true;
                    
                    let timeLeft = waitTime;
                    const interval = setInterval(() => {
                        timeLeft -= 1;
                        const counterEl = document.getElementById(msgId);
                        if (counterEl) {
                            counterEl.textContent = Math.max(0, timeLeft);
                        }
                        if (timeLeft <= 0) {
                            clearInterval(interval);
                            submitBtn.removeAttribute('data-rate-limited');
                            submitBtn.disabled = false;
                            messageInput.disabled = false;
                            messageInput.focus();
                        }
                    }, 1000);
                } else if (result.error === "SQL_ERROR") {
                    appendAiMessage(`<div style="color: #dc2626; font-weight: 500; font-size: 14.5px;">Please try again.</div>`);
                } else {
                    appendAiMessage(`<div style="color: #dc2626; font-weight: 500;">Error:</div><pre class="sql-pre">${JSON.stringify(result, null, 2)}</pre>`);
                }
            } catch (err) {
                loader.remove();
                appendAiMessage(`<div style="color: #dc2626; font-weight: 500;">Network Error processing chat request.</div>`);
            } finally {
                if (!submitBtn.hasAttribute('data-rate-limited')) {
                    submitBtn.disabled = false;
                    messageInput.focus();
                }
            }
        });

        // Submit on Enter (Shift+Enter for newline)
        document.getElementById('messageInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                chatForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
            }
        });

        // View Toggling & Tabular Logic
        const chatViewBtn = document.getElementById('chatViewBtn');
        const tabViewBtn = document.getElementById('tabViewBtn');
        const chatView = document.getElementById('chatView');
        const tabularView = document.getElementById('tabularView');
        let reportsCache = [];

        chatViewBtn.addEventListener('click', () => {
            chatView.style.display = 'flex';
            tabularView.style.display = 'none';
            chatViewBtn.style.background = 'var(--primary)';
            tabViewBtn.style.background = '#374151';
        });

        tabViewBtn.addEventListener('click', () => {
            chatView.style.display = 'none';
            tabularView.style.display = 'block';
            chatViewBtn.style.background = '#374151';
            tabViewBtn.style.background = 'var(--primary)';
            loadReports();
        });

        async function loadReports() {
            const tbody = document.getElementById('reportsTableBody');
            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 24px; color: #64748b;">Loading reports...</td></tr>';
            try {
                const res = await fetch('/api/reports');
                const data = await res.json();
                if (data.success && data.reports) {
                    reportsCache = data.reports;
                    renderReports(data.reports);
                } else {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #dc2626; padding: 24px;">Failed to load reports.</td></tr>';
                }
            } catch (err) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #dc2626; padding: 24px;">Error connecting to server.</td></tr>';
            }
        }

        function renderReports(reports) {
            const tbody = document.getElementById('reportsTableBody');
            tbody.innerHTML = '';
            
            if (reports.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 24px; color: #64748b;">No compliance reports found. Please upload a dataset first.</td></tr>';
                return;
            }

            reports.forEach((row, index) => {
                const reportData = row.report || row; 
                const qa = reportData.qa || {};
                const tx = reportData.transaction || {};
                
                const accountId = row.account_id || tx.account_id || 'N/A';
                const txId = row.transaction_id || tx.transaction_id || qa.transaction_id || 'N/A';
                
                let riskScore = 'N/A';
                if (row.risk_score !== undefined && row.risk_score !== null) riskScore = row.risk_score;
                else if (qa.risk_score !== undefined && qa.risk_score !== null) riskScore = qa.risk_score;

                const riskLevel = row.risk_level || qa.risk_level || 'N/A';

                const riskColor = riskLevel === 'HIGH' ? '#dc2626' : (riskLevel === 'MEDIUM' ? '#d97706' : '#16a34a');

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><a onclick="openTransactionModal('${accountId}')">${accountId}</a></td>
                    <td>${txId}</td>
                    <td>${riskScore}</td>
                    <td><span style="font-weight: 600; color: ${riskColor}">${riskLevel}</span></td>
                    <td><button class="btn-view-details" onclick="openReportModal(${index})">View Details</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

        function createTableFromJSON(obj, depth = 0) {
            if (obj === null || obj === undefined) return '';
            
            let tableStyle = depth === 0 ? 'width: 100%;' : 'width: 100%; border: 1px solid #e5e7eb; margin: 4px 0; border-radius: 4px; box-shadow: none;';
            let html = `<table class="reports-table" style="${tableStyle}">`;
            
            if (depth === 0) {
                html += '<thead><tr><th style="width: 30%">Property</th><th>Value</th></tr></thead>';
            }
            html += '<tbody>';
            
            for (const [key, value] of Object.entries(obj)) {
                let displayValue = '';
                
                if (key === 'flags' && Array.isArray(value)) {
                    displayValue = '<div style="display: flex; gap: 8px; flex-wrap: wrap;">';
                    value.forEach(flag => {
                        displayValue += `<span style="background: #fee2e2; color: #991b1b; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;">${String(flag).replace(/</g, '&lt;')}</span>`;
                    });
                    displayValue += '</div>';
                } else if ((key === 'adverse_media_links' || key === 'links' || key === 'adverseMediaLinks') && Array.isArray(value)) {
                    displayValue = '<div style="display: flex; flex-direction: column; gap: 6px;">';
                    value.forEach(link => {
                        if (typeof link === 'string' && (link.startsWith('http') || link.startsWith('www'))) {
                            let url = link.startsWith('http') ? link : 'https://' + link;
                            displayValue += `<div><a href="${url}" target="_blank" style="word-break: break-all; font-size: 13px;">${link}</a></div>`;
                        } else if (typeof link === 'object') {
                            displayValue += createTableFromJSON(link, depth + 1);
                        } else {
                            displayValue += `<div>${String(link).replace(/</g, '&lt;')}</div>`;
                        }
                    });
                    displayValue += '</div>';
                } else if (Array.isArray(value)) {
                    displayValue = '<div style="display: flex; flex-direction: column; gap: 6px;">';
                    value.forEach((item) => {
                        if (typeof item === 'object' && item !== null) {
                            displayValue += `<div>${createTableFromJSON(item, depth + 1)}</div>`;
                        } else if (typeof item === 'string' && item.startsWith('http')) {
                            displayValue += `<div><a href="${item}" target="_blank" style="word-break: break-all; font-size: 13px;">${item}</a></div>`;
                        } else {
                            displayValue += `<div>${String(item).replace(/</g, '&lt;')}</div>`;
                        }
                    });
                    displayValue += '</div>';
                } else if (typeof value === 'object' && value !== null) {
                    displayValue = createTableFromJSON(value, depth + 1);
                } else {
                    let strVal = String(value);
                    if (strVal.startsWith('http')) {
                        displayValue = `<a href="${strVal}" target="_blank" style="word-break: break-all;">${strVal}</a>`;
                    } else {
                        displayValue = strVal.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>');
                    }
                }
                
                const displayKey = key.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
                
                let tdKeyStyle = depth === 0 
                    ? 'font-weight: 500; color: #374151; vertical-align: top;' 
                    : 'font-weight: 500; color: #475569; vertical-align: top; background: #f8fafc; border-right: 1px solid #e5e7eb; width: 30%; padding: 8px 12px; font-size: 13px;';
                
                let tdValStyle = depth === 0 
                    ? 'word-break: break-word; vertical-align: top;'
                    : 'word-break: break-word; vertical-align: top; padding: 8px 12px; font-size: 13px; background: white;';
                
                html += `<tr><td style="${tdKeyStyle}">${displayKey}</td><td style="${tdValStyle}">${displayValue}</td></tr>`;
            }
            html += '</tbody></table>';
            return html;
        }

        function openReportModal(index) {
            const report = reportsCache[index];
            document.getElementById('reportModalContent').innerHTML = createTableFromJSON(report);
            document.getElementById('reportModal').style.display = 'flex';
        }

        async function openTransactionModal(accountId) {
            if (accountId === 'N/A') return;
            
            const content = document.getElementById('transactionModalContent');
            document.getElementById('transactionModalTitle').textContent = `Transactions for Account: ${accountId}`;
            content.innerHTML = '<div style="padding: 20px; text-align: center; color: #64748b;">Loading transactions...</div>';
            document.getElementById('transactionModal').style.display = 'flex';

            try {
                const res = await fetch(`/api/transactions/${accountId}`);
                const data = await res.json();
                if (data.success && data.transactions) {
                    if (data.transactions.length > 0) {
                        let html = '<div style="overflow-x: auto;"><table class="reports-table"><thead><tr>';
                        const keys = Object.keys(data.transactions[0]).filter(k => k !== 'analysis_status' && k !== 'uploaded_at');
                        keys.forEach(k => html += `<th>${k.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}</th>`);
                        html += '</tr></thead><tbody>';
                        
                        data.transactions.forEach(tx => {
                            html += '<tr>';
                            keys.forEach(k => {
                                html += `<td>${tx[k] !== null && tx[k] !== undefined ? String(tx[k]).replace(/</g, '&lt;') : ''}</td>`;
                            });
                            html += '</tr>';
                        });
                        html += '</tbody></table></div>';
                        content.innerHTML = html;
                    } else {
                        content.innerHTML = '<div style="padding: 20px; text-align: center; color: #64748b;">No transactions found.</div>';
                    }
                } else {
                    content.innerHTML = '<div style="padding: 20px; text-align: center; color: #dc2626;">Failed to load transaction data.</div>';
                }
            } catch (err) {
                content.innerHTML = '<div style="padding: 20px; text-align: center; color: #dc2626;">Error connecting to server.</div>';
            }
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.remove('active');
        }

        async function downloadSAR(txnDataEncoded, verdictEncoded) {
            try {
                const transaction = JSON.parse(decodeURIComponent(txnDataEncoded));
                const verdict = decodeURIComponent(verdictEncoded);

                const response = await fetch('/api/sar/download', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ transaction, verdict })
                });

                if (!response.ok) {
                    throw new Error("Failed to download SAR");
                }

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = `SAR_${transaction.transaction_id || 'Report'}.pdf`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
            } catch (error) {
                console.error("SAR Download Error:", error);
                alert("Could not generate SAR. Please try again.");
            }
        }
    </script>
</body>
</html>