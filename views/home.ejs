<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TRACE - AI Compliance</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        :root {
            --bg-main: #212121;
            --bg-sidebar: #171717;
            --bg-input: #2f2f2f;
            --text-primary: #ececec;
            --text-secondary: #b4b4b4;
            --hover-bg: #2f2f2f;
            --border-color: #383838;
        }

        body, html {
            margin: 0; padding: 0; height: 100vh;
            font-family: Söhne, "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Ubuntu, Cantarell, "Noto Sans", sans-serif;
            background: var(--bg-main); color: var(--text-primary);
            overflow: hidden;
        }

        /* Custom Scrollbar to match ChatGPT */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.2);
            border-radius: 999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }
        
        /* For Firefox */
        * {
            scrollbar-width: thin;
            scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
        }

        .app-container {
            display: flex; height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 260px; background: var(--bg-sidebar); color: var(--text-primary);
            display: flex; flex-direction: column; padding: 16px 12px; box-sizing: border-box;
        }

        .sidebar-header { margin-bottom: 24px; padding: 0 8px; }
        .sidebar-header h2 { font-size: 16px; font-weight: 600; margin: 0; color: var(--text-primary); }

        .sidebar-menu { display: flex; flex-direction: column; gap: 4px; }
        
        .sidebar-item {
            display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 8px;
            background: transparent; color: var(--text-primary); border: none; cursor: pointer;
            font-size: 14px; font-weight: 500; transition: background 0.2s; font-family: inherit;
            text-align: left;
        }
        .sidebar-item:hover, .sidebar-item.active { background: var(--hover-bg); }
        .sidebar-item svg { color: var(--text-primary); flex-shrink: 0; }

        .upload-status {
            padding: 12px; border-radius: 8px; font-size: 13px; line-height: 1.4; margin-top: 10px;
            background: var(--bg-input); border: 1px solid var(--border-color);
        }
        .upload-status.success { color: #a7f3d0; border-color: #059669; }
        .upload-status.error { color: #fecaca; border-color: #dc2626; }
        .upload-status.processing { color: #bfdbfe; border-color: #2563eb; }

        /* Main Chat Area */
        .chat-container {
            flex: 1; display: flex; flex-direction: column; background: var(--bg-main); position: relative;
        }

        .chat-history {
            flex: 1; overflow-y: auto; padding: 40px 20px 0; display: flex; flex-direction: column; gap: 24px;
            scroll-behavior: smooth; position: relative; align-items: center;
        }

        .empty-state {
            position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%);
            text-align: center; display: flex;
        }
        .empty-state h2 { font-size: 28px; font-weight: 600; margin: 0; color: var(--text-primary); letter-spacing: -0.5px; }

        .message {
            display: flex; gap: 16px; width: 100%; max-width: 800px; padding: 0 12px; box-sizing: border-box;
        }

        .message.user { justify-content: flex-end; }
        .message.ai { justify-content: flex-start; }

        .avatar {
            width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-weight: 600; font-size: 12px; flex-shrink: 0; color: white;
        }
        .message.ai .avatar { background: #10a37f; } /* ChatGPT icon color */
        .message.ai .avatar svg { width: 18px; height: 18px; }
        .message.user .avatar { display: none; }

        .message-content {
            font-size: 16px; line-height: 1.6; max-width: 80%; overflow-x: auto;
        }

        .message.user .message-content {
            background: var(--bg-input); padding: 12px 18px; border-radius: 20px;
            color: var(--text-primary); word-break: break-word;
        }

        .message.ai .message-content {
            color: var(--text-primary); width: 100%; max-width: 100%;
        }

        /* AI Message Rich Content Elements */
        .verdict-box { background: var(--bg-sidebar); border: 1px solid var(--border-color); padding: 16px; border-radius: 8px; margin-bottom: 16px; color: var(--text-primary); font-size: 14.5px; overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; background: transparent; }
        th, td { border: 1px solid var(--border-color); padding: 10px 14px; text-align: left; }
        th { background: #2a2a2a; font-weight: 600; color: var(--text-primary); }
        .table-responsive { overflow-x: auto; border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 16px; }
        .sql-pre { background: #000000; color: #e2e8f0; padding: 12px 16px; border-radius: 8px; font-size: 13px; overflow-x: auto; margin: 0; }

        /* Input Area */
        .input-area {
            padding: 20px 40px; width: 100%; max-width: 800px; margin: 0 auto; box-sizing: border-box;
            background: linear-gradient(0deg, var(--bg-main) 70%, rgba(33,33,33,0));
        }

        .input-area form {
            position: relative; display: flex; gap: 12px; align-items: flex-end;
            background: var(--bg-input); border: 1px solid transparent;
            border-radius: 24px; padding: 8px 12px;
        }
        .input-area form:focus-within { border-color: #555; }

        .btn-attach {
            height: 36px; width: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            background: transparent; color: var(--text-primary); border: none; cursor: pointer; flex-shrink: 0; margin-bottom: 2px;
        }
        .btn-attach:hover { background: #404040; }

        .input-area textarea {
            flex: 1; min-height: 24px; max-height: 200px; padding: 10px 0; border: none; resize: none; font-size: 16px;
            line-height: 1.5; font-family: inherit; background: transparent; color: var(--text-primary); outline: none;
        }
        .input-area textarea::placeholder { color: #8e8e8e; }

        .input-area #chatBtn {
            height: 36px; width: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            background: #ececec; color: #212121; border: none; cursor: pointer; transition: 0.2s; flex-shrink: 0; margin-bottom: 2px;
        }
        .input-area #chatBtn:hover { background: #ffffff; }
        .input-area #chatBtn:disabled { background: #404040; color: #8e8e8e; cursor: not-allowed; }

        .disclaimer { text-align: center; font-size: 12px; color: var(--text-secondary); margin-top: 12px; }

        /* Loading Spinner */
        .loading-badge { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; color: var(--text-secondary); font-weight: 500; }
        .spinner-small { width: 14px; height: 14px; border: 2px solid var(--text-secondary); border-top-color: transparent; border-radius: 50%; animation: spin 0.8s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        /* Tabular View & Modals */
        #tabularView { flex: 1; padding: 40px; overflow-y: auto; display: none; background: var(--bg-main); }
        #tabularView h2 { margin-top: 0; margin-bottom: 24px; color: var(--text-primary); }
        .reports-table { width: 100%; border-collapse: collapse; background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 8px; overflow: hidden; font-size: 14px; color: var(--text-primary); }
        .reports-table th, .reports-table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--border-color); }
        .reports-table th { background: #2f2f2f; font-weight: 600; color: var(--text-primary); }
        .reports-table tr:last-child td { border-bottom: none; }
        .reports-table tr:hover { background: #2a2a2a; }
        .reports-table a { color: #60a5fa; text-decoration: none; cursor: pointer; font-weight: 500; }
        .reports-table a:hover { text-decoration: underline; }
        .btn-view-details { background: #ffffff; color: #000000; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 500; transition: 0.2s; }
        .btn-view-details:hover { background: #d4d4d4; }

        #searchInput, #riskFilter {
            background: var(--bg-input); color: var(--text-primary); border: 1px solid var(--border-color); padding: 10px; border-radius: 8px; font-size: 14px; outline: none;
        }
        #searchInput:focus, #riskFilter:focus { border-color: #555; }
        #searchInput::placeholder { color: var(--text-secondary); }

        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.75); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal-content { background: var(--bg-main); color: var(--text-primary); width: 85%; max-width: 900px; max-height: 85vh; border-radius: 20px; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8); border: 1px solid var(--border-color); }
        .modal-header { padding: 24px 24px 16px; display: flex; justify-content: space-between; align-items: center; background: transparent; border-bottom: none; }
        .modal-header h3 { margin: 0; color: var(--text-primary); font-size: 20px; font-weight: 600; letter-spacing: -0.02em; }
        .close-modal { background: none; border: none; font-size: 28px; cursor: pointer; color: var(--text-secondary); line-height: 1; padding: 0; transition: color 0.2s; }
        .close-modal:hover { color: var(--text-primary); }
        .modal-body { padding: 0 24px 24px; overflow-y: auto; flex: 1; }
        .json-pre { background: #000000; color: #e2e8f0; padding: 16px; border-radius: 8px; overflow-x: auto; margin: 0; font-size: 13.5px; line-height: 1.5; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }
        
        /* Utility */
        .hidden { display: none !important; }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <h2>TRACE</h2>
            </div>
            
            <div class="sidebar-menu">
                <button type="button" id="addDatasetBtn" class="sidebar-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                    Add dataset
                </button>
                <button type="button" id="chatViewBtn" class="sidebar-item active">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                    Chat view
                </button>
                <button type="button" id="tabViewBtn" class="sidebar-item">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                    Tabular view
                </button>
            </div>
            
            <div style="flex: 1;"></div>
            
            <!-- Hidden Upload Form -->
            <form id="uploadForm" class="hidden">
                <input type="file" name="csvFile" id="csvFile" accept=".csv" required>
            </form>
            <div id="uploadStatus" class="upload-status hidden"></div>
        </aside>

        <!-- Main Chat Area -->
        <main class="chat-container" id="chatView">
            <div class="chat-history" id="chatHistory">
                <div class="empty-state" id="emptyState">
                    <h2>What's on your mind today?</h2>
                </div>
            </div>

            <!-- Input area -->
            <div class="input-area">
                <form id="chatForm">
                    <button type="button" class="btn-attach" onclick="document.getElementById('addDatasetBtn').click()">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </button>
                    <textarea name="message" id="messageInput" placeholder="Ask anything" required rows="1" oninput="this.style.height = ''; this.style.height = Math.min(this.scrollHeight, 200) + 'px'"></textarea>
                    <button type="submit" id="chatBtn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
                    </button>
                </form>
                <div class="disclaimer">TRACE can make mistakes. Verify important information.</div>
            </div>
        </main>

        <!-- Tabular View Area -->
        <main id="tabularView">
            <h2>Compliance Reports</h2>

            <!-- Stat Cards -->
            <div id="statsCards" style="display: flex; gap: 16px; margin-bottom: 24px;"></div>

            <!-- Filter and Search Area -->
            <div style="display: flex; gap: 12px; margin-bottom: 16px; align-items: center;">
                <input type="text" id="searchInput" placeholder="Search by Account ID, Transaction ID, or Customer Name..." style="flex: 1;">
                <select id="riskFilter">
                    <option value="ALL">All Risk Levels</option>
                    <option value="HIGH">High Risk</option>
                    <option value="MEDIUM">Medium Risk</option>
                    <option value="LOW">Low Risk</option>
                </select>
                <button id="exportBriefBtn" class="btn-view-details" style="background: #ffffff; color: #000; display: flex; align-items: center; gap: 6px; padding: 10px 16px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    Export PDF Brief
                </button>
            </div>

            <div style="overflow-x: auto; border-radius: 8px; border: 1px solid var(--border-color);">
                <table class="reports-table">
                    <thead>
                        <tr>
                            <th>Account ID</th>
                            <th>Transaction ID</th>
                            <th>Risk Score</th>
                            <th>Risk Level</th>
                            <th>Flags</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="reportsTableBody">
                        <tr><td colspan="6" style="text-align: center; color: var(--text-secondary);">No data loaded.</td></tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <!-- Modals -->
    <div id="reportModal" class="modal-overlay" onclick="if(event.target===this) closeModal('reportModal')">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="reportModalTitle">Compliance Report Details</h3>
                <button class="close-modal" onclick="closeModal('reportModal')">&times;</button>
            </div>
            <div class="modal-body">
                <div id="reportModalContent"></div>
            </div>
        </div>
    </div>

    <div id="transactionModal" class="modal-overlay" onclick="if(event.target===this) closeModal('transactionModal')">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="transactionModalTitle">Transaction Details</h3>
                <button class="close-modal" onclick="closeModal('transactionModal')">&times;</button>
            </div>
            <div class="modal-body">
                <div id="transactionModalContent"></div>
            </div>
        </div>
    </div>

    <script>
        const chatHistory = document.getElementById('chatHistory');
        const uploadForm = document.getElementById('uploadForm');
        const chatForm = document.getElementById('chatForm');
        const csvFile = document.getElementById('csvFile');
        const addDatasetBtn = document.getElementById('addDatasetBtn');
        const emptyState = document.getElementById('emptyState');
        
        function scrollToBottom() {
            chatHistory.scrollTop = chatHistory.scrollHeight;
        }

        function appendUserMessage(text) {
            if (emptyState) emptyState.classList.add('hidden');
            const msg = document.createElement('div');
            msg.className = 'message user';
            msg.innerHTML = `
                <div class="message-content">${text.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</div>
            `;
            chatHistory.appendChild(msg);
            scrollToBottom();
        }

        function appendAiMessage(htmlContent) {
            if (emptyState) emptyState.classList.add('hidden');
            const msg = document.createElement('div');
            msg.className = 'message ai';
            msg.innerHTML = `
                <div class="avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10H12V2z"></path><path d="M12 12 2.1 7.1"></path><path d="M12 12l9.9 4.9"></path></svg>
                </div>
                <div class="message-content" style="width: 100%; max-width: 100%;">${htmlContent}</div>
            `;
            chatHistory.appendChild(msg);
            scrollToBottom();
            return msg;
        }

        // Handle Add Dataset Click
        addDatasetBtn.addEventListener('click', () => {
            csvFile.click();
        });

        csvFile.addEventListener('change', () => {
            if (csvFile.files.length > 0) {
                uploadForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
            }
        });

        // Handle CSV Upload
        uploadForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData();
            const statusEl = document.getElementById('uploadStatus');

            if (csvFile.files.length === 0) return;
            formData.append('csvFile', csvFile.files[0]);

            statusEl.classList.remove('hidden');
            statusEl.textContent = "Processing and analyzing dataset...";
            statusEl.className = "upload-status processing";

            try {
                const response = await fetch('/api/upload', {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();
                
                if (response.ok) {
                    statusEl.textContent = `✓ ${result.message}`;
                    statusEl.className = "upload-status success";
                    appendAiMessage(`<strong>Dataset Uploaded Successfully</strong><br>Parsed and synced ${result.totalInserted} records. I am ready to answer your questions!`);
                } else {
                    statusEl.textContent = `✗ Error: ${result.error || 'Upload failed'}`;
                    statusEl.className = "upload-status error";
                }
            } catch (err) {
                statusEl.textContent = `✗ Network error during upload.`;
                statusEl.className = "upload-status error";
            }
        });

        // Handle Chat Query
        let conversationContext = [];
        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();
            const submitBtn = document.getElementById('chatBtn');

            if (!message) return;

            // Add user message to UI
            appendUserMessage(message);
            messageInput.value = '';
            messageInput.style.height = '';
            submitBtn.disabled = true;

            // Show Loading Indicator in Chat
            const loader = appendAiMessage(`
                <div class="loading-badge" id="activeLoader">
                    <div class="spinner-small"></div>
                    Thinking...
                </div>
            `);

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message, history: conversationContext })
                });
                const result = await response.json();

                // Remove loader
                loader.remove();

                if (result.success && result.results) {
                    let aiHtml = '';

                    // Verdict
                    if (result.complianceVerdict) {
                        let formattedVerdict = result.complianceVerdict.split(/(<(?:table|ul|ol)[\s\S]*?<\/(?:table|ul|ol)>)/i);
                        for (let i = 0; i < formattedVerdict.length; i++) {
                            if (!/^<(?:table|ul|ol)/i.test(formattedVerdict[i])) {
                                formattedVerdict[i] = formattedVerdict[i].replace(/\n/g, '<br>');
                            }
                        }
                        aiHtml += `<div class="verdict-box">${formattedVerdict.join('')}</div>`;
                        
                        // Update History Context
                        conversationContext.push({ role: 'user', content: message });
                        conversationContext.push({ role: 'assistant', content: result.sql });
                        if (conversationContext.length > 16) {
                            conversationContext = conversationContext.slice(-16); // Keep last 8 turns
                        }
                    }

                    const highRiskTxns = result.results.filter(r => r.risk_level && r.risk_level.toUpperCase() === 'HIGH');
                    if (highRiskTxns.length > 0) {
                        const txnData = encodeURIComponent(JSON.stringify(highRiskTxns[0])).replace(/'/g, '%27');
                        const verdictData = encodeURIComponent(result.complianceVerdict || "").replace(/'/g, '%27');
                        aiHtml += `<button style="margin-top: 10px; background-color: #dc2626; color: white; font-weight: bold; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="downloadSAR('${txnData}', '${verdictData}')">
                                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                      Download SAR
                                   </button>`;
                    }

                    appendAiMessage(aiHtml);
                } else if (result.error === "RATE_LIMIT" || response.status === 429) {
                    const waitTime = result.retryAfter || 15;
                    const msgId = 'countdown-' + Date.now();
                    appendAiMessage(`<div style="color: #ea580c; font-weight: 500; font-size: 14.5px;">Rate limit reached. Please wait <span id="${msgId}">${waitTime}</span> seconds before sending another message.</div>`);
                    
                    submitBtn.setAttribute('data-rate-limited', 'true');
                    submitBtn.disabled = true;
                    messageInput.disabled = true;
                    
                    let timeLeft = waitTime;
                    const interval = setInterval(() => {
                        timeLeft -= 1;
                        const counterEl = document.getElementById(msgId);
                        if (counterEl) {
                            counterEl.textContent = Math.max(0, timeLeft);
                        }
                        if (timeLeft <= 0) {
                            clearInterval(interval);
                            submitBtn.removeAttribute('data-rate-limited');
                            submitBtn.disabled = false;
                            messageInput.disabled = false;
                            messageInput.focus();
                        }
                    }, 1000);
                } else if (result.error === "SQL_ERROR") {
                    let errorMessage = result.details || "The query generated was invalid.";
                    appendAiMessage(`
                        <div style="color: #f87171; font-weight: 500; font-size: 14.5px; margin-bottom: 8px;">
                            Oops, I had trouble understanding or querying the database.
                        </div>
                        <div style="font-size: 13.5px; color: #fca5a5; background: rgba(220, 38, 38, 0.2); padding: 12px; border-radius: 6px; border: 1px solid #7f1d1d;">
                            <strong>Error Details:</strong><br>
                            ${String(errorMessage).replace(/</g, '&lt;')}
                        </div>
                    `);
                } else {
                    appendAiMessage(`<div style="color: #f87171; font-weight: 500;">Error:</div><pre class="sql-pre">${JSON.stringify(result, null, 2)}</pre>`);
                }
            } catch (err) {
                loader.remove();
                appendAiMessage(`<div style="color: #f87171; font-weight: 500;">Network Error processing chat request.</div>`);
            } finally {
                if (!submitBtn.hasAttribute('data-rate-limited')) {
                    submitBtn.disabled = false;
                    messageInput.focus();
                }
            }
        });

        // Submit on Enter (Shift+Enter for newline)
        document.getElementById('messageInput').addEventListener('keydown', function(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                chatForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
            }
        });

        // View Toggling & Tabular Logic
        const chatViewBtn = document.getElementById('chatViewBtn');
        const tabViewBtn = document.getElementById('tabViewBtn');
        const chatView = document.getElementById('chatView');
        const tabularView = document.getElementById('tabularView');
        let reportsCache = [];

        chatViewBtn.addEventListener('click', () => {
            chatView.style.display = 'flex';
            tabularView.style.display = 'none';
            chatViewBtn.classList.add('active');
            tabViewBtn.classList.remove('active');
        });

        tabViewBtn.addEventListener('click', () => {
            chatView.style.display = 'none';
            tabularView.style.display = 'block';
            chatViewBtn.classList.remove('active');
            tabViewBtn.classList.add('active');
            loadReports();
        });

        async function loadReports() {
            const tbody = document.getElementById('reportsTableBody');
            tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 24px; color: var(--text-secondary);">Loading reports...</td></tr>';
            try {
                const res = await fetch('/api/reports');
                const data = await res.json();
                if (data.success && data.reports) {
                    reportsCache = data.reports;
                    renderReports(data.reports);
                } else {
                    tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #f87171; padding: 24px;">Failed to load reports.</td></tr>';
                }
            } catch (err) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #f87171; padding: 24px;">Error connecting to server.</td></tr>';
            }
        }

        const searchInput = document.getElementById('searchInput');
        const riskFilter = document.getElementById('riskFilter');

        searchInput.addEventListener('input', applyFilters);
        riskFilter.addEventListener('change', applyFilters);

        function applyFilters() {
            const term = searchInput.value.toLowerCase();
            const risk = riskFilter.value;

            const filtered = reportsCache.filter(row => {
                const reportData = row.report || row;
                const tx = reportData.transaction || {};
                const qa = reportData.qa || {};
                
                const accountId = (row.account_id || tx.account_id || '').toLowerCase();
                const txId = (row.transaction_id || tx.transaction_id || qa.transaction_id || '').toLowerCase();
                const name = (row.customer_name || tx.customer_name || '').toLowerCase();
                
                const riskLevel = (row.risk_level || qa.risk_level || 'N/A').toUpperCase();

                const matchesSearch = accountId.includes(term) || txId.includes(term) || name.includes(term);
                const matchesRisk = risk === 'ALL' || riskLevel === risk;

                return matchesSearch && matchesRisk;
            });

            renderReportsTable(filtered);
        }

        function updateStats(reports) {
            let high = 0, medium = 0, low = 0;
            reports.forEach(row => {
                const reportData = row.report || row;
                const qa = reportData.qa || {};
                const riskLevel = (row.risk_level || qa.risk_level || 'N/A').toUpperCase();
                if (riskLevel === 'HIGH') high++;
                else if (riskLevel === 'MEDIUM') medium++;
                else if (riskLevel === 'LOW') low++;
            });

            const statsCards = document.getElementById('statsCards');
            statsCards.innerHTML = `
                <div style="flex: 1; padding: 16px; border-radius: 8px; border: 1px solid #ef4444; color: #ef4444; background: transparent; text-align: center;">
                    <div style="font-size: 14px; font-weight: 600; text-transform: uppercase; margin-bottom: 4px;">High Risk</div>
                    <div style="font-size: 28px; font-weight: bold;">${high}</div>
                </div>
                <div style="flex: 1; padding: 16px; border-radius: 8px; border: 1px solid #f59e0b; color: #f59e0b; background: transparent; text-align: center;">
                    <div style="font-size: 14px; font-weight: 600; text-transform: uppercase; margin-bottom: 4px;">Medium Risk</div>
                    <div style="font-size: 28px; font-weight: bold;">${medium}</div>
                </div>
                <div style="flex: 1; padding: 16px; border-radius: 8px; border: 1px solid #10b981; color: #10b981; background: transparent; text-align: center;">
                    <div style="font-size: 14px; font-weight: 600; text-transform: uppercase; margin-bottom: 4px;">Low Risk</div>
                    <div style="font-size: 28px; font-weight: bold;">${low}</div>
                </div>
            `;
        }

        function renderReports(reports) {
            updateStats(reports);
            applyFilters();
        }

        function renderReportsTable(reports) {
            const tbody = document.getElementById('reportsTableBody');
            tbody.innerHTML = '';
            
            if (reports.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 24px; color: var(--text-secondary);">No matching compliance reports found.</td></tr>';
                return;
            }

            reports.forEach((row) => {
                const index = reportsCache.indexOf(row);
                const reportData = row.report || row; 
                const qa = reportData.qa || {};
                const tx = reportData.transaction || {};
                
                const accountId = row.account_id || tx.account_id || 'N/A';
                const txId = row.transaction_id || tx.transaction_id || qa.transaction_id || 'N/A';
                
                let riskScore = 'N/A';
                if (row.risk_score !== undefined && row.risk_score !== null) riskScore = row.risk_score;
                else if (qa.risk_score !== undefined && qa.risk_score !== null) riskScore = qa.risk_score;

                const riskLevel = row.risk_level || qa.risk_level || 'N/A';
                const riskColor = riskLevel === 'HIGH' ? '#f87171' : (riskLevel === 'MEDIUM' ? '#fbbf24' : '#4ade80');

                let flagsHtml = '-';
                const flagsArr = row.flags || qa.flags || [];
                if (Array.isArray(flagsArr) && flagsArr.length > 0) {
                    flagsHtml = '<div style="display: flex; gap: 4px; flex-wrap: wrap;">';
                    flagsArr.forEach(flag => {
                        flagsHtml += `<span style="background: rgba(255,255,255,0.1); color: var(--text-primary); padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 600;">${String(flag).replace(/</g, '&lt;')}</span>`;
                    });
                    flagsHtml += '</div>';
                } else if (typeof flagsArr === 'string') {
                    try {
                        const parsed = JSON.parse(flagsArr);
                        if (Array.isArray(parsed) && parsed.length > 0) {
                            flagsHtml = '<div style="display: flex; gap: 4px; flex-wrap: wrap;">';
                            parsed.forEach(flag => {
                                flagsHtml += `<span style="background: rgba(255,255,255,0.1); color: var(--text-primary); padding: 2px 6px; border-radius: 4px; font-size: 11px; font-weight: 600;">${String(flag).replace(/</g, '&lt;')}</span>`;
                            });
                            flagsHtml += '</div>';
                        }
                    } catch(e) {}
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td><a onclick="openTransactionModal('${accountId}')">${accountId}</a></td>
                    <td>${txId}</td>
                    <td>${riskScore}</td>
                    <td><span style="font-weight: 600; color: ${riskColor}">${riskLevel}</span></td>
                    <td>${flagsHtml}</td>
                    <td><button class="btn-view-details" onclick="openReportModal(${index})">View Details</button></td>
                `;
                tbody.appendChild(tr);
            });
        }

        function createTableFromJSON(obj, depth = 0) {
            if (obj === null || obj === undefined) return '';
            
            let tableStyle = depth === 0 ? 'width: 100%;' : 'width: 100%; border: 1px solid var(--border-color); margin: 4px 0; border-radius: 4px; box-shadow: none;';
            let html = `<table class="reports-table" style="${tableStyle}">`;
            
            if (depth === 0) {
                html += '<thead><tr><th style="width: 30%">Property</th><th>Value</th></tr></thead>';
            }
            html += '<tbody>';
            
            for (const [key, value] of Object.entries(obj)) {
                let displayValue = '';
                
                if (key === 'flags' && Array.isArray(value)) {
                    displayValue = '<div style="display: flex; gap: 8px; flex-wrap: wrap;">';
                    value.forEach(flag => {
                        displayValue += `<span style="background: rgba(220, 38, 38, 0.2); color: #fca5a5; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;">${String(flag).replace(/</g, '&lt;')}</span>`;
                    });
                    displayValue += '</div>';
                } else if ((key === 'adverse_media_links' || key === 'links' || key === 'adverseMediaLinks') && Array.isArray(value)) {
                    displayValue = '<div style="display: flex; flex-direction: column; gap: 6px;">';
                    value.forEach(link => {
                        if (typeof link === 'string' && (link.startsWith('http') || link.startsWith('www'))) {
                            let url = link.startsWith('http') ? link : 'https://' + link;
                            displayValue += `<div><a href="${url}" target="_blank" style="word-break: break-all; font-size: 13px; color: #60a5fa;">${link}</a></div>`;
                        } else if (typeof link === 'object') {
                            displayValue += createTableFromJSON(link, depth + 1);
                        } else {
                            displayValue += `<div>${String(link).replace(/</g, '&lt;')}</div>`;
                        }
                    });
                    displayValue += '</div>';
                } else if (Array.isArray(value)) {
                    displayValue = '<div style="display: flex; flex-direction: column; gap: 6px;">';
                    value.forEach((item) => {
                        if (typeof item === 'object' && item !== null) {
                            displayValue += `<div>${createTableFromJSON(item, depth + 1)}</div>`;
                        } else if (typeof item === 'string' && item.startsWith('http')) {
                            displayValue += `<div><a href="${item}" target="_blank" style="word-break: break-all; font-size: 13px; color: #60a5fa;">${item}</a></div>`;
                        } else {
                            displayValue += `<div>${String(item).replace(/</g, '&lt;')}</div>`;
                        }
                    });
                    displayValue += '</div>';
                } else if (typeof value === 'object' && value !== null) {
                    const nestedTable = createTableFromJSON(value, depth + 1);
                    if (depth <= 2) {
                        displayValue = `<details style="border: 1px solid var(--border-color); border-radius: 6px; margin: 4px 0;">
                            <summary style="padding: 8px 12px; background: #2a2a2a; cursor: pointer; font-size: 13px; font-weight: 500; color: var(--text-primary); border-bottom: 1px solid var(--border-color);">
                                Expand to view data
                            </summary>
                            <div style="padding: 0; overflow-x: auto;">
                                ${nestedTable}
                            </div>
                        </details>`;
                    } else {
                        displayValue = nestedTable;
                    }
                } else {
                    let strVal = String(value);
                    if (strVal.startsWith('http')) {
                        displayValue = `<a href="${strVal}" target="_blank" style="word-break: break-all; color: #60a5fa;">${strVal}</a>`;
                    } else {
                        displayValue = strVal.replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>');
                    }
                }
                
                const displayKey = key.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
                
                let tdKeyStyle = depth === 0 
                    ? 'font-weight: 500; color: var(--text-primary); vertical-align: top;' 
                    : 'font-weight: 500; color: var(--text-secondary); vertical-align: top; background: #2a2a2a; border-right: 1px solid var(--border-color); width: 30%; padding: 8px 12px; font-size: 13px;';
                
                let tdValStyle = depth === 0 
                    ? 'word-break: break-word; vertical-align: top;'
                    : 'word-break: break-word; vertical-align: top; padding: 8px 12px; font-size: 13px; background: transparent;';
                
                html += `<tr><td style="${tdKeyStyle}">${displayKey}</td><td style="${tdValStyle}">${displayValue}</td></tr>`;
            }
            html += '</tbody></table>';
            return html;
        }

        function openReportModal(index) {
            const report = reportsCache[index];
            document.getElementById('reportModalContent').innerHTML = createTableFromJSON(report);
            document.getElementById('reportModal').style.display = 'flex';
        }

        async function openTransactionModal(accountId) {
            if (accountId === 'N/A') return;
            
            const content = document.getElementById('transactionModalContent');
            document.getElementById('transactionModalTitle').textContent = `Transactions for Account: ${accountId}`;
            content.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-secondary);">Loading transactions...</div>';
            document.getElementById('transactionModal').style.display = 'flex';

            try {
                const res = await fetch(`/api/transactions/${accountId}`);
                const data = await res.json();
                if (data.success && data.transactions) {
                    if (data.transactions.length > 0) {
                        let html = '<div style="overflow-x: auto;"><table class="reports-table"><thead><tr>';
                        const keys = Object.keys(data.transactions[0]).filter(k => k !== 'analysis_status' && k !== 'uploaded_at');
                        keys.forEach(k => html += `<th>${k.split('_').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}</th>`);
                        html += '</tr></thead><tbody>';
                        
                        data.transactions.forEach(tx => {
                            html += '<tr>';
                            keys.forEach(k => {
                                html += `<td>${tx[k] !== null && tx[k] !== undefined ? String(tx[k]).replace(/</g, '&lt;') : ''}</td>`;
                            });
                            html += '</tr>';
                        });
                        html += '</tbody></table></div>';
                        content.innerHTML = html;
                    } else {
                        content.innerHTML = '<div style="padding: 20px; text-align: center; color: var(--text-secondary);">No transactions found.</div>';
                    }
                } else {
                    content.innerHTML = '<div style="padding: 20px; text-align: center; color: #f87171;">Failed to load transaction data.</div>';
                }
            } catch (err) {
                content.innerHTML = '<div style="padding: 20px; text-align: center; color: #f87171;">Error connecting to server.</div>';
            }
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        async function downloadSAR(txnDataEncoded, verdictEncoded) {
            try {
                const transaction = JSON.parse(decodeURIComponent(txnDataEncoded));
                const verdict = decodeURIComponent(verdictEncoded);

                const response = await fetch('/api/sar/download', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ transaction, verdict })
                });

                if (!response.ok) {
                    throw new Error("Failed to download SAR");
                }

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = `SAR_${transaction.transaction_id || 'Report'}.pdf`;
                document.body.appendChild(a);
                a.click();
                window.URL.revokeObjectURL(url);
                document.body.removeChild(a);
            } catch (error) {
                console.error("SAR Download Error:", error);
                alert("Could not generate SAR. Please try again.");
            }
        }

        // Export Executive Brief PDF
        document.getElementById('exportBriefBtn').addEventListener('click', () => {
            if (!reportsCache || reportsCache.length === 0) {
                alert("No reports to export.");
                return;
            }

            const btn = document.getElementById('exportBriefBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<span class="spinner-small" style="display: inline-block; width: 14px; height: 14px; border-width: 2px;"></span> Exporting...';
            btn.disabled = true;

            const container = document.createElement('div');
            container.style.padding = '20px 30px';
            container.style.fontFamily = 'Inter, ui-sans-serif, system-ui, sans-serif';
            container.style.color = '#111827';
            container.style.background = '#ffffff';
            container.style.width = '900px';
            
            // To prevent html2canvas clipping, we append to DOM off-screen
            const wrapper = document.createElement('div');
            wrapper.style.position = 'absolute';
            wrapper.style.left = '-9999px';
            wrapper.style.top = '0';
            wrapper.appendChild(container);
            document.body.appendChild(wrapper); 

            let html = `
                <style>
                    #pdfContent th, #pdfContent td { border-left: none !important; border-right: none !important; border-top: none !important; }
                </style>
                <div id="pdfContent">
                    <div style="border-bottom: 2px solid #e5e7eb; padding-bottom: 16px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: flex-end;">
                        <div>
                            <h1 style="margin: 0; font-size: 26px; color: #111827; letter-spacing: -0.02em;">Executive Compliance Brief</h1>
                            <p style="margin: 6px 0 0; color: #6b7280; font-size: 13px;">TRACE AI-Generated Report</p>
                        </div>
                        <div style="text-align: right; color: #6b7280; font-size: 12px;">
                            Date: ${new Date().toLocaleDateString()}<br>
                            Time: ${new Date().toLocaleTimeString()}
                        </div>
                    </div>
            `;

            let high = 0, medium = 0, low = 0;
            const highRiskTxns = [];
            reportsCache.forEach(row => {
                const reportData = row.report || row;
                const qa = reportData.qa || {};
                const tx = reportData.transaction || {};
                const riskLevel = (row.risk_level || qa.risk_level || 'N/A').toUpperCase();
                
                if (riskLevel === 'HIGH') {
                    high++;
                    highRiskTxns.push(row);
                }
                else if (riskLevel === 'MEDIUM') medium++;
                else if (riskLevel === 'LOW') low++;
            });

            html += `
                <div style="display: flex; gap: 20px; margin-bottom: 32px;">
                    <div style="flex: 1; padding: 20px; border-radius: 8px; border: 1px solid #fca5a5; background: #fef2f2; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                        <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; margin-bottom: 6px; color: #dc2626; letter-spacing: 0.05em;">High Risk</div>
                        <div style="font-size: 28px; font-weight: bold; color: #991b1b; line-height: 1;">${high}</div>
                    </div>
                    <div style="flex: 1; padding: 20px; border-radius: 8px; border: 1px solid #fcd34d; background: #fffbeb; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                        <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; margin-bottom: 6px; color: #d97706; letter-spacing: 0.05em;">Medium Risk</div>
                        <div style="font-size: 28px; font-weight: bold; color: #92400e; line-height: 1;">${medium}</div>
                    </div>
                    <div style="flex: 1; padding: 20px; border-radius: 8px; border: 1px solid #86efac; background: #ecfdf5; text-align: center; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                        <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; margin-bottom: 6px; color: #059669; letter-spacing: 0.05em;">Low Risk</div>
                        <div style="font-size: 28px; font-weight: bold; color: #065f46; line-height: 1;">${low}</div>
                    </div>
                </div>
            `;

            html += `<h2 style="font-size: 18px; color: #111827; border-bottom: 1px solid #e5e7eb; padding-bottom: 10px; margin-bottom: 20px;">Critical High-Risk Transactions (${highRiskTxns.length})</h2>`;
            
            if (highRiskTxns.length > 0) {
                html += `<table style="width: 100%; border-collapse: collapse; margin-bottom: 24px; font-size: 11.5px;">
                    <thead>
                        <tr style="background: #f9fafb;">
                            <th style="padding: 10px 14px; border-bottom: 2px solid #e5e7eb; text-align: left; font-weight: 600; color: #374151; background: #f9fafb;">Account ID</th>
                            <th style="padding: 10px 14px; border-bottom: 2px solid #e5e7eb; text-align: left; font-weight: 600; color: #374151; background: #f9fafb;">Transaction ID</th>
                            <th style="padding: 10px 14px; border-bottom: 2px solid #e5e7eb; text-align: left; font-weight: 600; color: #374151; background: #f9fafb;">Detected Flags</th>
                        </tr>
                    </thead>
                    <tbody>`;
                
                highRiskTxns.forEach(row => {
                    const reportData = row.report || row;
                    const qa = reportData.qa || {};
                    const tx = reportData.transaction || {};
                    const accountId = row.account_id || tx.account_id || 'N/A';
                    const txId = row.transaction_id || tx.transaction_id || qa.transaction_id || 'N/A';
                    
                    let flagsStr = '-';
                    const flagsArr = row.flags || qa.flags || [];
                    if (Array.isArray(flagsArr)) flagsStr = flagsArr.join(', ');
                    else if (typeof flagsArr === 'string') {
                        try {
                            const parsed = JSON.parse(flagsArr);
                            if (Array.isArray(parsed)) flagsStr = parsed.join(', ');
                        } catch(e) {}
                    }

                    html += `
                        <tr>
                            <td style="padding: 10px 14px; border-bottom: 1px solid #e5e7eb; font-weight: 600; color: #111827;">${accountId}</td>
                            <td style="padding: 10px 14px; border-bottom: 1px solid #e5e7eb; color: #4b5563;">${txId}</td>
                            <td style="padding: 10px 14px; border-bottom: 1px solid #e5e7eb; color: #dc2626;">${flagsStr.replace(/</g, '&lt;')}</td>
                        </tr>
                    `;
                });
                html += `</tbody></table>`;
            } else {
                html += `<p style="color: #6b7280; font-size: 12px; font-style: italic; padding: 14px; background: #f9fafb; border-radius: 8px;">No high-risk transactions detected in this report.</p>`;
            }
            html += `</div>`; // Close pdfContent

            container.innerHTML = html;

            const opt = {
                margin:       10,
                filename:     'TRACE_Executive_Brief.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, scrollX: 0, scrollY: 0 },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'landscape' }
            };

            html2pdf().set(opt).from(container).save().then(() => {
                document.body.removeChild(wrapper);
                btn.innerHTML = originalText;
                btn.disabled = false;
            }).catch(err => {
                console.error("PDF generation failed:", err);
                alert("Failed to generate PDF");
                if (document.body.contains(wrapper)) document.body.removeChild(wrapper);
                btn.innerHTML = originalText;
                btn.disabled = false;
            });
        });
    </script>
</body>
</html>